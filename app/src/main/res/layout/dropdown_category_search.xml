<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="8dp">

    <!-- Search Bar with Cross Icon - Keep existing UI -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/etSearchCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search categories..."
            android:inputType="text"
            android:padding="12dp"
            android:paddingEnd="40dp"
            android:background="@drawable/rounded_edittext_bg"
            android:textSize="14sp"
            android:fontFamily="@font/inter_regular"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp" />

        <!-- Cross Icon - inside the EditText -->
        <ImageView
            android:id="@+id/ivClearCategorySearch"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_cross"
            android:contentDescription="Clear search"
            android:visibility="gone"
            android:alpha="0.0"
            android:tint="#999999"
            android:clickable="true"
            android:focusable="true" />

    </RelativeLayout>

    <!-- Category List - No separators between items -->
    <ListView
        android:id="@+id/lvCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="200dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:paddingVertical="2dp" />

</LinearLayout>