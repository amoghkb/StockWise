<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:elevation="8dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp"
        android:background="@color/white">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Select Vehicles"
            android:textSize="16sp"
            android:fontFamily="@font/inter_bold"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvClearAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear All"
            android:textSize="12sp"
            android:fontFamily="@font/inter_medium"
            android:textColor="#FF4444"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0" />

    <!-- Search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="@color/white">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/etSearchVehicle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search vehicles..."
                android:inputType="text"
                android:padding="12dp"
                android:paddingEnd="40dp"
                android:background="@drawable/rounded_edittext_bg"
                android:textSize="14sp"
                android:fontFamily="@font/inter_regular"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp" />

            <!-- Cross Icon - inside the EditText -->
            <ImageView
                android:id="@+id/ivClearVehicleSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_cross"
                android:contentDescription="Clear search"
                android:visibility="gone"
                android:alpha="0.0"
                android:tint="#999999"
                android:clickable="true"
                android:focusable="true" />

        </RelativeLayout>
    </LinearLayout>
    <!-- Vehicle Type Filter Chips - BELOW SEARCH -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        android:paddingHorizontal="12dp"
        android:scrollbars="none"
        android:background="@color/white">

        <LinearLayout
            android:id="@+id/vehicleTypeChipsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <!-- ListView -->
    <ListView
        android:id="@+id/lvVehicles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:divider="#E0E0E0"
        android:dividerHeight="1dp"
        android:isScrollContainer="true"
        android:overScrollMode="always"
        android:background="@color/white"
        android:paddingVertical="4dp" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No vehicles found"
        android:textSize="14sp"
        android:fontFamily="@font/inter_medium"
        android:textColor="#999999"
        android:gravity="center"
        android:padding="30dp"
        android:visibility="gone" />

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="12dp"
        android:paddingHorizontal="12dp"
        android:background="@drawable/rounded_design_bg"
        android:layout_marginTop="1dp">

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 vehicles selected"
            android:textSize="13sp"
            android:fontFamily="@font/inter_medium"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/btnConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm"
            android:textSize="14sp"
            android:fontFamily="@font/inter_bold"
            android:textColor="@android:color/white"
            android:background="@drawable/rounded_save_bg"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>