<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="#E0E0E0" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add Custom Item"
                android:textSize="18sp"
                android:fontFamily="@font/inter_bold"
                android:textColor="#1B2340" />

            <ImageView
                android:id="@+id/ivCloseSheet"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_cross"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                app:tint="#6B7280" />
        </LinearLayout>

        <!-- ========== ITEM NAME ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Item Name"
                android:textSize="14sp"
                android:fontFamily="@font/inter_bold"
                android:textColor="#000000"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etCustomName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g., Coolant 5L"
                android:inputType="text"
                android:padding="14dp"
                android:background="@drawable/rounded_edittext_bg"
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="#1B2340" />
        </LinearLayout>

        <!-- ========== QUANTITY ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quantity"
                android:textSize="14sp"
                android:fontFamily="@font/inter_bold"
                android:textColor="#000000"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etCustomQty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0"
                android:inputType="number"
                android:padding="14dp"
                android:background="@drawable/rounded_edittext_bg"
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="#1B2340" />
        </LinearLayout>

        <!-- ========== NOTES ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notes / Description (Optional)"
                android:textSize="14sp"
                android:fontFamily="@font/inter_bold"
                android:textColor="#000000"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etCustomNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g., Check viscosity rating..."
                android:inputType="text|textMultiLine"
                android:gravity="top|start"
                android:padding="14dp"
                android:background="@drawable/rounded_edittext_bg"
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="#1B2340"
                android:minLines="3"
                android:maxLines="6" />
        </LinearLayout>

        <!-- ========== ADD BUTTON (kept full width, same id) ========== -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAddCustomItem"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="14dp"
            android:background="@drawable/rounded_save_bg"
            android:text="Add to Procurement"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:fontFamily="@font/inter_regular" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>