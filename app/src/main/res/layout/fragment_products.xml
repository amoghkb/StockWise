<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.fragment.ProductsFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:paddingBottom="80dp">

            <!-- Search Bar -->
            <EditText
                android:id="@+id/etSearchProducts"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Search products, SKUs..."
                android:inputType="text"
                android:padding="14dp"
                android:paddingLeft="44dp"
                android:background="@drawable/rounded_edittext_bg"
                android:textSize="16sp"
                android:drawableStart="@drawable/ic_search"
                android:drawableLeft="@drawable/ic_search"
                android:drawablePadding="12dp"
                android:drawableTint="#80A9A9A9"
                android:gravity="center_vertical" />


            <!-- Dynamic Category Container -->
            <LinearLayout
                android:id="@+id/categoryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_product"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_plus"
        android:padding="4dp"
        android:backgroundTint="@color/stock_wise_primary"
        app:tint="@android:color/white"
        app:borderWidth="0dp"
        app:fabSize="normal"
        app:rippleColor="#33FFFFFF"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Circle" />
</FrameLayout>