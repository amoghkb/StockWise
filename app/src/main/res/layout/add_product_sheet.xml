<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Menu Container -->
        <LinearLayout
            android:id="@+id/menuContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- "Create New" Title -->
            <TextView
                android:id="@+id/tvCreateNew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create New"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Add New Category -->
            <LinearLayout
                android:id="@+id/btnAddCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="18dp"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/rounded_design_bg"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="56dp"
                    android:background="@drawable/rounded_design_icon_bg">

                    <ImageView
                        android:id="@+id/ivCategoryIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_category" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/tvCategoryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add New Category"
                        android:textSize="16sp"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="#000000"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvCategorySubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create a new product grouping"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="#666666" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivCategoryChevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="#999999" />
            </LinearLayout>

            <!-- Add New Item -->
            <LinearLayout
                android:id="@+id/btnAddItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="18dp"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/rounded_design_bg"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="56dp"
                    android:background="@drawable/rounded_design_icon_bg">

                    <ImageView
                        android:id="@+id/ivItemIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_item" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/tvItemTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add New Item"
                        android:textSize="16sp"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="#000000"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvItemSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add a single product to inventory"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="#666666" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivItemChevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="#999999" />
            </LinearLayout>
            <!-- Cancel Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancel"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:padding="14dp"
                android:fontFamily="@font/inter_regular"
                android:background="@drawable/rounded_design_button"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- ========== CATEGORY FORM ========== -->
        <LinearLayout
            android:id="@+id/categoryFormContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/btnBackToMenu"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_back_button"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvNewCategory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="New Category"
                    android:textSize="18sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- Category Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/tvCategoryNameLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category Name"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etCategoryName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g., Electronics"
                    android:inputType="text"
                    android:padding="14dp"
                    android:background="@drawable/rounded_edittext_bg"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Description -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/tvCategoryDescLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description (Optional)"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etCategoryDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Brief description of this category"
                    android:inputType="text|textMultiLine"
                    android:gravity="top|start"
                    android:padding="14dp"
                    android:background="@drawable/rounded_edittext_bg"
                    android:textSize="16sp"
                    android:minLines="3"
                    android:maxLines="6" />
            </LinearLayout>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCategoryCancel"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cancel"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:padding="14dp"
                    android:fontFamily="@font/inter_regular"
                    android:background="@drawable/rounded_design_button"
                    android:layout_marginEnd="8dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSaveCategory"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Save Category"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:padding="14dp"
                    android:fontFamily="@font/inter_regular"
                    android:background="@drawable/rounded_save_bg"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ========== ITEM FORM ========== -->
        <LinearLayout
            android:id="@+id/itemFormContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/btnBackToMenuFromItem"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_back_button"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvNewItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="New Item"
                    android:textSize="18sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- Image Selection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/tvItemImageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Item Image"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/btnSelectImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="@drawable/rounded_design_button"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivItemImage"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_belts"
                        android:scaleType="centerCrop"
                        android:padding="4dp"
                        android:background="@drawable/rounded_design_bg" />

                    <TextView
                        android:id="@+id/tvTapToSelect"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="Tap to select image"
                        android:textColor="#666666"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/ivDeleteImage"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_plus"
                        app:tint="#999999" />
                </LinearLayout>
            </LinearLayout>

            <!-- Category Dropdown -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/tvCategoryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginBottom="8dp" />

                <AutoCompleteTextView
                    android:id="@+id/etCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select Category"
                    android:padding="14dp"
                    android:background="@drawable/rounded_edittext_bg"
                    android:textSize="16sp"
                    android:dropDownHeight="wrap_content"
                    android:completionThreshold="1" />
            </LinearLayout>

            <!-- Item Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/tvItemNameLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Item Name"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etItemName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g., Oil"
                    android:inputType="text"
                    android:padding="14dp"
                    android:background="@drawable/rounded_edittext_bg"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Price Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="18dp">

                <!-- Original Price -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/tvOriginalPriceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Original Price"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_bold"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etOriginalPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:padding="14dp"
                        android:background="@drawable/rounded_edittext_bg"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Selling Price -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/tvSellingPriceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selling Price"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_bold"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etSellingPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:padding="14dp"
                        android:background="@drawable/rounded_edittext_bg"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Stock -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/tvStockLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="17dp"
                    android:text="Stock In Godown"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etStock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0"
                    android:inputType="number"
                    android:padding="14dp"
                    android:background="@drawable/rounded_edittext_bg"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Description -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/tvItemDescLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description (Optional)"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etItemDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Product details"
                    android:inputType="text|textMultiLine"
                    android:gravity="top|start"
                    android:padding="14dp"
                    android:background="@drawable/rounded_edittext_bg"
                    android:textSize="16sp"
                    android:minLines="3"
                    android:maxLines="6" />
            </LinearLayout>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnItemCancel"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cancel"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:padding="14dp"
                    android:fontFamily="@font/inter_regular"
                    android:background="@drawable/rounded_design_button"
                    android:layout_marginEnd="8dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSaveItem"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Save Item"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:padding="14dp"
                    android:fontFamily="@font/inter_regular"
                    android:background="@drawable/rounded_save_bg"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>