<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    tools:context=".fragment.ItemDetailFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:background="#FFFFFF">

            <!-- Top Row: Back and Edit buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="#FFFFFF">

                <!-- Back button -->
                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_back_button"
                    android:background="@drawable/rounded_circle_button"
                    android:padding="10dp"
                    android:contentDescription="Back"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Title in center -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Item Details"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1B2340"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center" />

                <!-- Edit/Pencil button -->
                <ImageView
                    android:id="@+id/btn_edit"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_edit"
                    android:background="@drawable/rounded_circle_button"
                    android:padding="10dp"
                    android:contentDescription="Edit"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Product Image Card with rounded corners -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <ImageView
                    android:id="@+id/img_product"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:contentDescription="Product image" />

            </androidx.cardview.widget.CardView>

            <!-- Content Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:layout_marginTop="12dp">

                <!-- Category tag - rounded -->
                <TextView
                    android:id="@+id/tv_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/category_tag_background"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:text="Lubricants"
                    android:textColor="#8A8FA3"
                    android:textSize="11sp" />

                <!-- Title -->
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Castrol Edge 5W-40 Synthetic Motor Oil"
                    android:textColor="#1B2340"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_bold" />

                <!-- Description -->
                <TextView
                    android:id="@+id/tv_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Advanced full synthetic motor oil designed to keep your engine running like new by providing exceptional wear protection, cleaning power and overall performance."
                    android:textColor="#9096A8"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_regular" />

                <!-- SKU / Brand row - single line -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:text="SKU: "
                            android:textColor="#B0B5C6"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_medium" />

                        <TextView
                            android:id="@+id/tv_sku"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CAS-OIL-001"
                            android:textColor="#1B2340"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter_bold" />
                    </LinearLayout>

                </LinearLayout>

                <!-- ===== Stats grid 2x2 with clean cards ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- Current Stock Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_design_bg"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp">

                            <!-- Icon top right -->
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentTop="true"
                                android:src="@drawable/ic_current_stock"
                                android:contentDescription="Current Stock Icon" />

                            <!-- Label top left -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentTop="true"
                                android:text="Current Stock"
                                android:textColor="#6B7280"
                                android:textSize="11sp"
                                android:fontFamily="@font/inter_medium" />

                            <!-- Number bottom left -->
                            <TextView
                                android:id="@+id/tv_current_stock"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentBottom="true"
                                android:text="124"
                                android:textColor="#1B2340"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/inter_bold" />

                            <!-- In Stock badge bottom right -->
                            <TextView
                                android:id="@+id/tv_stock_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/badge_green_background"
                                android:paddingStart="12dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="4dp"
                                android:text="In Stock"
                                android:textColor="#FFFFFF"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/inter_bold" />
                        </RelativeLayout>
                    </LinearLayout>

                    <!-- Cost Price Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_design_bg"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp">

                            <!-- Icon top right -->
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentTop="true"
                                android:src="@drawable/ic_money"
                                android:contentDescription="Cost Price Icon" />

                            <!-- Label top left -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentTop="true"
                                android:text="Cost Price"
                                android:textColor="#6B7280"
                                android:textSize="11sp"
                                android:fontFamily="@font/inter_medium" />

                            <!-- Number bottom left -->
                            <TextView
                                android:id="@+id/tv_cost_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentBottom="true"
                                android:text="₹22.50"
                                android:textColor="#1B2340"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/inter_bold" />

                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- Selling Price Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_design_bg"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp">

                            <!-- Icon top right -->
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentTop="true"
                                android:src="@drawable/ic_selling_price"
                                android:contentDescription="Selling Price Icon" />

                            <!-- Label top left -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentTop="true"
                                android:text="Selling Price"
                                android:textColor="#6B7280"
                                android:textSize="11sp"
                                android:fontFamily="@font/inter_medium" />

                            <!-- Number bottom left -->
                            <TextView
                                android:id="@+id/tv_selling_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentBottom="true"
                                android:text="₹38.99"
                                android:textColor="#1B2340"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/inter_bold" />

                        </RelativeLayout>
                    </LinearLayout>

                    <!-- Total Sales Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_design_bg"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp">

                            <!-- Icon top right -->
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentTop="true"
                                android:src="@drawable/ic_total_sales"
                                android:contentDescription="Total Sales Icon" />

                            <!-- Label top left -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentTop="true"
                                android:text="Total Sales"
                                android:textColor="#6B7280"
                                android:textSize="11sp"
                                android:fontFamily="@font/inter_medium" />

                            <!-- Number bottom left -->
                            <TextView
                                android:id="@+id/tv_total_sales"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentBottom="true"
                                android:text="342"
                                android:textColor="#1B2340"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/inter_bold" />

                            <!-- Units text bottom right -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:layout_alignParentEnd="true"
                                android:text="units"
                                android:textColor="#9CA3AF"
                                android:textSize="11sp"
                                android:fontFamily="@font/inter_medium" />

                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Add to Sale/Bill button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_add_to_sale"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/rounded_save_bg"
                    android:drawablePadding="8dp"
                    android:drawableTint="#FFFFFF"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Add to Today Sale"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter_bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>