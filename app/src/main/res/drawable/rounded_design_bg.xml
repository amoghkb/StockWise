<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item
        android:left="0dp"
        android:top="3dp"
        android:right="0dp"
        android:bottom="3dp">
        <shape>
            <solid android:color="#30000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Main card background -->
    <item
        android:bottom="2dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape>
            <solid android:color="#FFFFFF" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#E8ECF1" />
        </shape>
    </item>
</layer-list>